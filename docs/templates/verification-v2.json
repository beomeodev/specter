{
  "contract": "verification-v2",
  "version": "1.0.0",
  "comment": "Single executable authority for the verification-v2 contract (docs/design/verification-v2.md). Risk is declared (Feature Map '### Verification signals') or observed (deterministic changed-file facts). Never inferred from spec/plan/tasks prose.",
  "signals": [
    "authorization",
    "secrets",
    "data-migration",
    "destructive-data",
    "irreversible-operation",
    "public-contract",
    "financial-or-regulated",
    "gate-or-policy-change"
  ],
  "signal_values": ["yes", "no"],
  "round_budget": {
    "automatic_rounds": 2
  },
  "reviewer_effort": {
    "codex": "xhigh",
    "antigravity": "medium"
  },
  "decision_types": [
    "ack-migration",
    "ack-destructive",
    "ack-irreversible",
    "ack-gate-policy",
    "ack-degrade",
    "authorize-round",
    "accept-warn",
    "stop"
  ],
  "ack_required_classes": {
    "data-migration": "ack-migration",
    "destructive-data": "ack-destructive",
    "irreversible-operation": "ack-irreversible",
    "gate-or-policy-change": "ack-gate-policy"
  },
  "diff_path_classes": {
    "data-migration": [
      "(^|/)db/migrations/",
      "(^|/)alembic/versions/",
      "(^|/)prisma/migrations/",
      "(^|/)migrations/[^/]+\\.(sql|py|ts|js|rb)$"
    ],
    "authorization": [
      "(^|/)(auth|authz|authorization|permissions?|rbac|acl|oauth|sessions?)(/|\\.|_|-)"
    ],
    "secrets": [
      "(^|/)(secrets?|credentials?|keyring|vault)(/|\\.|_|-)",
      "(^|/)\\.env(\\.|$)"
    ],
    "public-contract": [
      "(^|/)(openapi|swagger)\\.(json|ya?ml)$",
      "(^|/)public-api/"
    ],
    "gate-or-policy-change": [
      "^\\.claude/",
      "^\\.github/workflows/",
      "^docs/templates/scripts/",
      "^docs/templates/verification-v2\\.json$",
      "^scripts/specter/",
      "(^|/)\\.specify/scripts/",
      "(^|/)hooks/",
      "(^|/)\\.pre-commit-config\\.ya?ml$"
    ]
  },
  "diff_content_classes": {
    "data-migration": [
      "\\b(CREATE|ALTER|DROP)[[:space:]]+(TABLE|INDEX|COLUMN|SCHEMA)\\b"
    ],
    "destructive-data": [
      "\\bDROP[[:space:]]+(TABLE|SCHEMA|DATABASE)\\b",
      "\\bTRUNCATE[[:space:]]+TABLE\\b",
      "\\bDELETE[[:space:]]+FROM\\b"
    ]
  },
  "diff_content_comment": "Content classes are applied ONLY to added lines of the working diff and to untracked file contents — never to spec/plan/tasks prose.",
  "diff_exclude_paths": [
    ".specify/",
    "docs/review/",
    "docs/prd/checklists/",
    "docs/audits/"
  ],
  "high_risk_checks": [
    "security-and-trust-boundaries",
    "data-integrity",
    "state-ownership-and-invariants",
    "rollback",
    "failure-modes",
    "public-contract-compatibility",
    "relevant-real-entrypoint-or-e2e"
  ]
}
